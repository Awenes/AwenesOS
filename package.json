{
  "name": "awenes-os",
  "productName": "AwenesOS",
  "description": "A local-first developer command center for safe agent-assisted delivery.",
  "author": "Awenes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config vite.renderer.config.ts && tsc -p tsconfig.desktop.json",
    "build:core": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "cli": "tsx src/cli.ts",
    "desktop:main": "tsc -p tsconfig.desktop.json",
    "desktop:renderer": "vite --config vite.renderer.config.ts",
    "desktop:build": "vite build --config vite.renderer.config.ts && tsc -p tsconfig.desktop.json",
    "desktop:start": "vite build --config vite.renderer.config.ts && tsc -p tsconfig.desktop.json && electron .",
    "package:win": "pnpm build && electron-builder --win nsis",
    "package:verify": "electron-builder --win nsis --publish=never",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:desktop-smoke": "node scripts/desktop-smoke.mjs",
    "test:watch": "vitest"
  },
  "main": "dist-desktop/main/desktop/main.js",
  "build": {
    "appId": "com.awenes.os",
    "productName": "AwenesOS",
    "publish": {
      "provider": "github",
      "owner": "Awenes",
      "repo": "AwenesOS",
      "releaseType": "draft"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@libsql/**/*",
      "node_modules/libsql/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "AwenesOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "commander": "^14.0.1",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "playwright-core": "^1.63.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
